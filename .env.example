# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://landslide:landslide@localhost:5432/landslide
REDIS_URL=redis://localhost:6379/0

# ─── Object storage (MinIO locally) ─────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=landslide-cogs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── Earth observation credentials ──────────────────────────
# Authentication uses Application Default Credentials by default:
#   gcloud auth application-default login
# Leave the two key settings blank unless you are deploying somewhere that
# needs a service-account key. Some organisations enforce
# iam.managed.disableServiceAccountKeyCreation, so keys cannot be created there.
GEE_PROJECT_ID=metron-work
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=
COPERNICUS_USER=
COPERNICUS_PASSWORD=
# NASA Earthdata reads ~/.netrc, not these — see docs/IMPLEMENTATION.md Phase 0
EARTHDATA_USER=
EARTHDATA_PASSWORD=

# ─── Alert gateways ─────────────────────────────────────────
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
IVR_CALLER_ID=

# ─── Risk engine ────────────────────────────────────────────
AOI_BBOX=88.30,26.85,88.85,27.45
AOI_NAME=NH10_Sevoke_Gangtok
UTM_CRS=EPSG:32645
FORECAST_HORIZONS=24,48,72
TIER_THRESHOLDS=0.25,0.50,0.75
INFERENCE_CRON=0 */3 * * *
INSAR_COHERENCE_THRESHOLD=0.30
SPATIAL_BLOCK_SIZE_M=5000

# ─── Application ────────────────────────────────────────────
JWT_SECRET=change-me
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
